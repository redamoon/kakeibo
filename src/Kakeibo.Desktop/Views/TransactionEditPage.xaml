<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Kakeibo.Desktop.Views.TransactionEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Kakeibo.Desktop.ViewModels"
    x:DataType="vm:TransactionEditViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="12" MaximumWidthRequest="480" HorizontalOptions="Start">

            <Label Text="日付" />
            <DatePicker Date="{Binding Date}" Format="yyyy/MM/dd" />

            <Label Text="種類" />
            <HorizontalStackLayout Spacing="16" RadioButtonGroup.GroupName="Kind">
                <RadioButton Content="支出" IsChecked="{Binding IsExpense}" />
                <RadioButton Content="収入" IsChecked="{Binding IsIncome}" />
            </HorizontalStackLayout>

            <Label Text="金額(円)" />
            <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="1000" />

            <Label Text="カテゴリ" />
            <Entry Text="{Binding Category}" Placeholder="食費" />

            <Label Text="メモ" />
            <Entry Text="{Binding Memo}" />

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#D93025" />

            <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                <Button Text="保存" Command="{Binding SaveCommand}" />
                <Button Text="キャンセル" Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Button Text="削除" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditing}"
                        BackgroundColor="#D93025" TextColor="White" Margin="24,0,0,0" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
